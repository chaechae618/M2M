APP_NAME=M2M API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local default. Replace with PostgreSQL in shared/production environments.
DATABASE_URL=sqlite:///./m2m.db
# DATABASE_URL=postgresql+psycopg://m2m:m2m@localhost:5432/m2m

JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# auto: API 키가 있으면 실제 Agent, 없으면 로컬 데모 Agent를 사용합니다.
# live: 실제 Agent만 사용하며 API 키가 없으면 서버가 명확한 오류를 반환합니다.
# demo: API 키와 무관하게 비용 없는 로컬 데모 Agent를 사용합니다.
MENTORING_AGENT_MODE=auto
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=45
MENTORING_AGENT_ROOT=../M2M-mentoring-agent
